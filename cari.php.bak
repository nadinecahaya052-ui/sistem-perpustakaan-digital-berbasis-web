<?php
require "koneksi.php";
$halaman_aktif_publik='cari';
$q=trim($_GET['q']??''); $penulis=trim($_GET['penulis']??''); $id_kategori=(int)($_GET['kategori']??0); $id_jenis=(int)($_GET['jenis']??0); $urut=$_GET['urut']??'terbaru';
$per_halaman=8; $halaman=max(1,(int)($_GET['halaman']??1)); $offset=($halaman-1)*$per_halaman;
$w='WHERE 1=1'; $params=[];
if($q!==''){ $x=bersihkan($koneksi,$q); $w.=" AND (b.judul LIKE '%$x%' OR b.pengarang LIKE '%$x%' OR b.penerbit LIKE '%$x%' OR b.isbn LIKE '%$x%' OR k.nama_kategori LIKE '%$x%' OR j.nama_jenis LIKE '%$x%' OR d.kode_ddc LIKE '%$x%')"; }
if($penulis!==''){ $x=bersihkan($koneksi,$penulis); $w.=" AND b.pengarang LIKE '%$x%'"; }
if($id_kategori>0)$w.=" AND b.id_kategori=$id_kategori"; if($id_jenis>0)$w.=" AND b.id_jenis=$id_jenis";
$order=$urut==='judul'?'b.judul ASC':($urut==='stok'?'b.stok DESC':'b.created_at DESC, b.id_buku DESC');
$total=(int)(mysqli_fetch_assoc(mysqli_query($koneksi,"SELECT COUNT(*) n FROM buku b LEFT JOIN kategori_buku k ON k.id_kategori=b.id_kategori LEFT JOIN jenis_buku j ON j.id_jenis=b.id_jenis LEFT JOIN klasifikasi_ddc d ON d.id_ddc=b.id_ddc $w"))['n']??0);
$pages=max(1,(int)ceil($total/$per_halaman));
$data=mysqli_query($koneksi,"SELECT b.*,k.nama_kategori,j.nama_jenis,d.kode_ddc FROM buku b LEFT JOIN kategori_buku k ON k.id_kategori=b.id_kategori LEFT JOIN jenis_buku j ON j.id_jenis=b.id_jenis LEFT JOIN klasifikasi_ddc d ON d.id_ddc=b.id_ddc $w ORDER BY $order LIMIT $per_halaman OFFSET $offset");
$cats=mysqli_query($koneksi,"SELECT * FROM kategori_buku ORDER BY nama_kategori"); $jenis=mysqli_query($koneksi,"SELECT * FROM jenis_buku ORDER BY nama_jenis");
$authors=mysqli_query($koneksi,"SELECT DISTINCT pengarang FROM buku WHERE pengarang<>'' ORDER BY pengarang");
$qs=$_GET; unset($qs['halaman']); $base=http_build_query($qs);
?>
<!DOCTYPE html><html lang="id"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Cari Buku | Perpustakaan Digital SMA Negeri Satu Kamal</title><link rel="stylesheet" href="assets/css/style.css"></head><body>
<?php include "includes/navbar_public.php"; ?><div class="hero"><h1>🔎 Cari Buku</h1><p>Cari berdasarkan judul, penulis, kategori, penerbit, ISBN, DDC atau kata kunci.</p></div>
<div class="search-panel"><form method="GET" id="filterForm"><div class="filter-grid"><input class="form-control" name="q" placeholder="Judul / kata kunci..." value="<?=htmlspecialchars($q)?>"><select class="form-control filter-select" name="penulis" onchange="this.form.submit()"><option value="">Semua Penulis</option><?php while($a=mysqli_fetch_assoc($authors)):?><option <?= $penulis===$a['pengarang']?'selected':'' ?>><?=htmlspecialchars($a['pengarang'])?></option><?php endwhile;?></select><select class="form-control filter-select" name="kategori" onchange="this.form.submit()"><option value="0">Semua Kategori</option><?php while($c=mysqli_fetch_assoc($cats)):?><option value="<?=$c['id_kategori']?>" <?=$id_kategori==$c['id_kategori']?'selected':''?>><?=htmlspecialchars($c['nama_kategori'])?></option><?php endwhile;?></select><select class="form-control filter-select" name="jenis" onchange="this.form.submit()"><option value="0">Semua Jenis</option><?php while($j=mysqli_fetch_assoc($jenis)):?><option value="<?=$j['id_jenis']?>" <?=$id_jenis==$j['id_jenis']?'selected':''?>><?=htmlspecialchars($j['nama_jenis'])?></option><?php endwhile;?></select><select class="form-control filter-select" name="urut" onchange="this.form.submit()"><option value="terbaru" <?=$urut==='terbaru'?'selected':''?>>Urutkan terbaru</option><option value="judul" <?=$urut==='judul'?'selected':''?>>Urutkan judul A-Z</option><option value="stok" <?=$urut==='stok'?'selected':''?>>Stok terbanyak</option></select></div><div class="filter-actions"><button type="submit" class="btn btn-primary">🔎 Cari</button><a class="btn btn-secondary" href="cari.php">↺ Reset</a></div></form><p class="pagination-info">Ditemukan <b><?=$total?></b> buku.</p></div>
<h3 class="section-title">Daftar Buku</h3><div class="buku-grid"><?php if(mysqli_num_rows($data)===0):?><p>Buku tidak ditemukan.</p><?php endif;?><?php while($b=mysqli_fetch_assoc($data)):?><div class="buku-card"><div class="cover-wrap"><div class="info-btn" onclick="bukaDetail(<?=$b['id_buku']?>)">i</div><img class="cover" src="assets/uploads/buku/<?=htmlspecialchars($b['cover'])?>" onerror="this.src='default.png'"></div><div class="body"><div class="judul"><?=htmlspecialchars($b['judul'])?></div><div class="meta">👤 <?=htmlspecialchars($b['pengarang'])?></div><div class="meta">🏷️ <?=htmlspecialchars($b['nama_kategori']??'-')?> · <?=htmlspecialchars($b['nama_jenis']??'-')?></div><div class="meta">📅 <?=htmlspecialchars($b['tahun_terbit'])?></div><div class="badges"><span class="badge badge-stok">Stok <?=$b['stok']?></span><span class="badge badge-rak">DDC <?=htmlspecialchars($b['kode_ddc']??'-')?></span></div></div></div><?php endwhile;?></div>
<div class="pagination"><?php for($p=1;$p<=$pages;$p++):?><a class="<?=$p===$halaman?'active':''?>" href="cari.php?<?=$base?>&halaman=<?=$p?>"><?=$p?></a><?php endfor;?></div><div class="modal-bg" id="modalDetail"><div class="modal-box" id="isiModal">Memuat...</div></div><footer class="site-footer">2026 &copy; Perpustakaan Digital SMA Negeri Satu Kamal</footer>
<script>function bukaDetail(id){document.getElementById('modalDetail').classList.add('show');fetch('detail_buku.php?id='+id).then(r=>r.text()).then(h=>document.getElementById('isiModal').innerHTML=h)}function tutupDetail(){document.getElementById('modalDetail').classList.remove('show')}document.getElementById('modalDetail').addEventListener('click',e=>{if(e.target===e.currentTarget)tutupDetail()})document.querySelectorAll('.filter-select').forEach(function(el){el.addEventListener('mousedown',function(){this.parentElement.style.zIndex='200';});});</script></body></html>
